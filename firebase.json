          }
        ]
      },
      {
        "source": "/main.dart.????????.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/main.dart.????????.js_*.part.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/canvaskit/????????????????????????????????????????/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/{index.html,flutter_bootstrap.js,flutter.js,main.dart.js,flutter_service_worker.js,version.json,manifest.json,app_links.json,sw.js,firebase-messaging-sw.js,offline.html,e2ee.worker.dart.js,recorder_compositor.js,video_protection.js}",
        "headers": [
