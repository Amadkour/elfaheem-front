# Copy to tools/runner/runner.env (git ignores it) and fill in. Never commit the real file.

# App versions › Build runner › New token (shown once)
NB_BUILDER_TOKEN=

# The Android release key: a key.properties with storeFile (absolute, or relative to this file), storePassword,
# keyAlias, keyPassword. Keep the keystore and this file outside the repository.
NB_KEY_PROPERTIES=C:/Users/you/alfaheem-keys/key.properties

# Optional
# NB_RUNNER_NAME=office-pc
# NB_RUNNER_PLATFORMS=windows,android,web
# NB_API_URL=https://alfheemacademy.com/api
# NB_REPO_URL=https://github.com/<owner>/<repo>.git
# NB_WORK_DIR=D:/nextbrain-runner
# NB_BASH=C:/Program Files/Git/bin/bash.exe
