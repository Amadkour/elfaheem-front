      {"key": "passport_no", "kind": "text", "label_ar": "رقم الجواز", "label_en": "Passport number", "required": "conditional", "when": {"nationality": "!EG"}, "group": "identity", "system": true},
      {"key": "nationality", "kind": "nationality", "label_ar": "الجنسية", "label_en": "Nationality", "required": "mandatory", "group": "identity", "system": true},
