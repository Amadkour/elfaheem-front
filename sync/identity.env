# Alfaheem identity: every value sync/apply_identity.py writes over NextBrain's.
# KEY=VALUE, UTF-8, one per line; '#' starts a comment. Owner decisions of 2026-11-14 (docs/DECISIONS_ALFAHEEM.md).

# Names. Never with "مركز" (owner rule).
APP_NAME_AR=الفهيم
APP_NAME_EN=Alfaheem
# The name under the launcher icon (Android label, iOS CFBundleDisplayName / CFBundleName).
LAUNCHER_NAME=الفهيم
# ASCII name for desktop binaries and bundle files (nextbrain.exe -> alfaheem.exe, NextBrain.app -> Alfaheem.app).
BINARY_NAME=alfaheem
# Company line ("by DoubleY") stays.
COMPANY_NAME=DoubleY

# Application ids (Android applicationId + namespace, iOS / macOS bundle id, Linux APPLICATION_ID, platform channel
# prefix, iOS Darwin IPC names). The App Group and the broadcast extension follow it.
APP_ID=com.doubley.alfaheem
APPLE_TEAM_ID=MVHKS8482X

# Domain: API, share / deep / profile / join / verify / export links, landing, legal pages.
DOMAIN=alfheemacademy.com

# TLS pins of the API host (lib/core/cert_pin.dart), comma-separated. EMPTY on purpose (A-002): NextBrain's pins are
# for nextbrain.site and must not ship. With both lists empty a mobile build accepts only a Let's Encrypt leaf for the
# API host (the backup rule). Add the SPKI SHA-256 once the alfheemacademy.com certificate exists:
#   openssl x509 -in /etc/letsencrypt/live/alfheemacademy.com/cert.pem -pubkey -noout \
#     | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
CERT_PIN_SPKI_SHA256=
CERT_PIN_LEGACY_SHA256=

# Android signing certificate SHA-256 fingerprints for web/.well-known/assetlinks.json (App Links), comma-separated.
# EMPTY until the Alfaheem release key exists (NextBrain's fingerprint must not ship).
ANDROID_SHA256_FINGERPRINTS=

# Native splash / launcher colours.
SPLASH_COLOR=#F4FBFF
SPLASH_COLOR_DARK=#0D3B7A
ADAPTIVE_ICON_BACKGROUND=#D4FEFD

# The Alfaheem checkout on the server (scripts/release, scripts/server): NextBrain's /root/nextbrain.
SERVER_DIR=/root/elfaheem

# Contact / support address shown by the landing site and the legal pages (owner, 2026-11-14).
CONTACT_EMAIL=alfaheem.2y@gmail.com
